# Server Configuration
PORT=5000

# MongoDB Connection
# Get your free MongoDB URI from: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/huntify?retryWrites=true&w=majority

# Puppeteer Configuration (Optional - for Railway/deployment)
# If deploying on Railway, you can use system Chrome by setting this to:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# Or leave empty to use Puppeteer's bundled Chrome
PUPPETEER_EXECUTABLE_PATH=
